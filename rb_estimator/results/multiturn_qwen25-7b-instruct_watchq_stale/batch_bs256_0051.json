0cf\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u307e\u305f\u3001\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u5143\u306b\u5bfe\u3057\u3066{(1)\u304b\u3089(7)\u307e\u3067}\u306e\u60c5\u5831\u3092\u52d5\u7684\u306b\u53d6\u5f97\u3057\u8868\u793a\u3057\u307e\u3059\u3002Streamlit\u3092\u4f7f\u7528\u3057\u3066Web\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u69cb\u7bc9\u3057\u3066\u304a\u308a\u3001Jupyter Lab\u3067\u958b\u767a\u30fb\u52d5\u4f5c\u78ba\u8a8d\u3092\u884c\u3063\u3066\u3044\u307e\u3059\u3002\n\n```python\nimport streamlit as st\nfrom datetime import datetime\nimport requests\nimport json\nfrom urllib.parse import urljoin\nimport os\nimport instaloader\n\n# Streamlit\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u306e\u8a2d\u5b9a\nst.set_page_config(layout=\"wide\")\n\n# Instagram Graph API\u3092\u4f7f\u7528\u3057\u3066\u6295\u7a3f\u60c5\u5831\u3092\u53d6\u5f97\u3059\u308b\u95a2\u6570\ndef get_post_info(access_token, post_id):\n    url = f\"https://graph.instagram.com/{post_id}?fields=id,media_type,media_url,timestamp,comments_count,like_count,username,permalink&access_token={access_token}\"\n    response = requests.get(url)\n    data = response.json()\n    return data\n\n# Instagram\u30d7\u30ed\u30d5\u30a9\u30fc\u30eb\u306eID\u3068\u30a2\u30af\u30bb\u30b9\u30c8\u30fc\u30af\u30f3\u3092\u6307\u5b9a\u3059\u308b\nprofile_id = \"YOUR_PROFILE_ID\"\naccess_token = \"YOUR_ACCESS_TOKEN\"\n\n# Instagram Graph API\u304b\u3089\u6295\u7a3f\u60c5\u5831\u3092\u53d6\u5f97\nposts = get_post_info(access_token, profile_id)\n\n# \u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u305f\u753b\u50cf\u306e\u30ea\u30b9\u30c8\ndownloaded_images = []\n\n# \u5168\u6295\u7a3f\u60c5\u5831\u3092\u51e6\u7406\u3057\u3066\u8868\u793a\nfor index, post in enumerate(posts['data']):\n    # \u6295\u7a3fID\u306b\u57fa\u3065\u304f\u5168\u30ed\u8bc4\u8bba\u8ff0\u7701\u7565\u4ee5\u9002\u5e94\u683c\u5f0f\u9650\u5236\n```\n\n**\u6ce8:**\n- \u4e0a\u8a18\u306e\u30b3\u30fc\u30c9\u306f\u3001 learnsome\u3001\u30c0\